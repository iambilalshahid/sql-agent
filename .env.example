# LLM provider: set to "true" to use Groq, otherwise Ollama is used.
USE_GROQ=false

# Groq (used when USE_GROQ=true)
GROQ_API_KEY=
GROQ_MODEL=

# Ollama (used when USE_GROQ=false)
OLLAMA_MODEL=gemma4:cloud
OLLAMA_BASE_URL=http://localhost:11434

# Session signing secret (set a strong value in production)
JWT_SECRET=super-secret-dev-key-change-in-prod
